@GAL_alignment_window_height = 250

guiTypes = {
	containerWindowType = {
		name = "GAL_alignment_button_window"
		position = { x = 403 y = 255 }
		size = { width = 83 height = 29 }
		containerWindowType = {
			name = "GAL_alignment_button_button_window"
			position = { x = 0 y = 0 }
			size = { width = 83 height = 29 }
			background = { name = "Background" quadTextureSprite = "GFX_tiled_window_small" alwaystransparent = yes }
			buttonType = { name = "GAL_alignment_open_button" position = { x = 0 y = 0 } spriteType = "GFX_GAL_alignment_button_compact" clicksound = click_ok oversound = ui_menu_over pdx_tooltip = GAL_alignment_button_tooltip }
			instantTextBoxType = { name = "GAL_alignment_button_title" position = { x = 0 y = 5 } text = GAL_alignment_button_text font = "hoi_16mbs" format = center maxWidth = 83 alwaystransparent = yes }
		}
	}

	containerWindowType = {
		name = "GAL_alignment_window"
		position = { x = -500 y = -250 }
		size = { width = 960 height = 580 }
		hide_position = { x = -500 y = -1000 }
		moveable = yes
		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300
		click_to_front = yes
		orientation = CENTER
		background = { name = "Background" quadTextureSprite = "GFX_tiled_plain_bg" }
		containerWindowType = {
			name = "GAL_alignment_title_container"
			position = { x = 0 y = 0 }
			size = { width = 960 height = 40 }
			background = { name = "Background" spriteType = "GFX_tiled_header_1" alwaystransparent = yes }
			instantTextBoxType = { name = "GAL_alignment_title_text" position = { x = 215 y = 0 } borderSize = { x = 0 y = 0 } text = GAL_alignment_title font = "hoi_36header" format = center maxWidth = 500 }
			buttonType = { name = "GAL_alignment_close_button" position = { x = -36 y = 4 } spriteType = "GFX_closebutton" clicksound = click_close pdx_tooltip = "CLOSE" shortcut = "ESCAPE" orientation = UPPER_RIGHT }
		}
		containerWindowType = {
			name = "GAL_alignment_list_container"
			position = { x = 0 y = 36 }
			size = { width = 100% height = 543 }
			orientation = UPPER_LEFT
			background = { name = "Background" quadTextureSprite = "GFX_tiled_research_bg" alwaystransparent = yes }
			containerWindowType = {
				name = "GAL_alignment_leaders_grid_container"
				position = { x = 8 y = 10 }
				size = { width = 944 height = 540 }
				margin = { top = 0 bottom = 8 }
				scroll_wheel_factor = 10
				smooth_scrolling = yes
				orientation = UPPER_LEFT
				verticalScrollbar = "right_vertical_slider"
				background = { name = "Background" spriteType = "GFX_tiled_window_transparent" alwaystransparent = yes }
				gridboxtype = { name = "GAL_alignment_leaders_grid" position = { x = 0 y = 0 } size = { width = 100%% height = 100%% } slotsize = { width = 470 height = 260 } max_slots_horizontal = 2 format = "UPPER_LEFT" }
			}
		}
	}

	containerWindowType = {
		name = "GAL_alignment_leaders_entry"
		size = { width = 462 height = @GAL_alignment_window_height }
		orientation = UPPER_LEFT
		background = { name = "Background" quadTextureSprite = "GFX_tiled_bg" alwaystransparent = yes }
		iconType = { name = "GAL_alignment_leaders_flag" quadTextureSprite = "GFX_GAL_republican_pact" position = { x = 36 y = 31 } scale = 0.32 centerposition = yes orientation = UPPER_LEFT alwaystransparent = yes }
		instantTextBoxType = { name = "GAL_alignment_faction_title" position = { x = 65 y = 20 } text = "[GALGetAlignmentTitleName]" font = "hoi_18mbs" format = left maxWidth = 260 }
		instantTextBoxType = { name = "GAL_alignment_faction_desc" position = { x = 20 y = 45 } text = "[GALGetAlignmentDesc]" font = "hoi_16mbs" format = left maxWidth = 300 maxHeight = 120 }
		containerWindowType = {
			name = "GAL_alignment_members_container"
			position = { x = 12 y = 180 }
			size = { width = 310 height = 54 }
			margin = { top = 4 bottom = 4 left = 4 right = 4 }
			smooth_scrolling = yes
			background = { name = "Background" spriteType = "GFX_tiled_window_transparent" alwaystransparent = yes }
			horizontalScrollbar = "bottom_horizontal_slider"
			gridboxtype = { name = "GAL_alignment_members" position = { x = 0 y = 0 } size = { width = 100%% height = 100%% } slotsize = { width = 48 height = 38 } max_slots_vertical = 1 add_horizontal = yes format = "UPPER_LEFT" }
		}
		containerWindowType = {
			name = "GAL_alignment_faction_info_container"
			position = { x = -115 y = 10 }
			size = { width = 110 height = 140 }
			orientation = upper_right
			instantTextBoxType = { name = "GAL_alignment_faction_info_title" position = { x = 0 y = 0 } text = GAL_alignment_faction_info_title font = "hoi_18mbs" format = center maxWidth = 110 }
			iconType = { name = "GAL_alignment_faction_info" position = { x = 55 y = 80 } scale = 1 orientation = UPPER_LEFT centerposition = yes pdx_tooltip = GAL_alignment_info_tooltip }
		}
	}

	containerWindowType = {
		name = "GAL_alignment_members_entry"
		size = { width = 48 height = 60 }
		orientation = UPPER_LEFT
		iconType = { name = "GAL_alignment_flag" quadTextureSprite = "GFX_flag_small2" position = { x = 5 y = 4 } orientation = UPPER_LEFT alwaystransparent = yes }
		iconType = { name = "GAL_alignment_flag_frame" spriteType = "GFX_diplo_countrylist_flag_frame" position = { x = 0 y = 0 } pdx_tooltip = GAL_country_name_tooltip }
	}
}
